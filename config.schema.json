{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "pseudo": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "signature": {
          "type": "object",
          "properties": {
            "light": {
              "type": "string",
              "pattern": "file://.*\\.(jpg|jpeg|png|gif)$"
            },
            "dark": {
              "type": "string",
              "pattern": "file://.*\\.(jpg|jpeg|png|gif)$"
            }
          },
          "required": ["light", "dark"]
        },
        "repository": {
          "type": "string"
        }
      },
      "required": ["name", "title", "pseudo", "url", "signature", "repository"]
    },
    "friends": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        },
        "required": ["name", "title", "company", "website"]
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": ["string", "null"]
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["remote", "onsite", "hybrid"]
              }
            },
            "required": ["city", "country", "type"]
          }
        },
        "required": ["company", "position", "start", "end", "description", "location", "website"]
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": ["name", "url"]
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "src": {
            "type": "string",
            "pattern": "file://.*\\.(jpg|jpeg|png|gif|svg)$"
          },
          "url": {
            "type": "string"
          }
        },
        "required": ["src", "url", "name", "description"]
      }
    },
    "hero": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "background": {
          "type": "string",
          "pattern": "file://.*\\.(jpg|jpeg|png|gif)$"
        }
      },
      "required": ["title", "subtitle", "background"]
    },
    "about": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "pattern": "file://.*\\.(jpg|jpeg|png|gif)$"
          }
        },
        "required": ["title", "image"]
      }
    }
  },
  "required": ["friends", "projects", "experiences", "profile", "links", "hero", "about"]
}
